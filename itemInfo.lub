	[40416] = {
		unidentifiedDisplayName = "Hoppel Card",
		unidentifiedResourceName = "이름없는카드",
		unidentifiedDescriptionName = {
			"[DIALOGUE]",
			"^1133aaHello there, kind soul.",
			"^1133aaI do hope I am not troubling you. I find myself in a most unfortunate predicament, you see. The dark, furry creature you have just defeated somehow absorbed my wandering spirit, and now I am quite hopelessly stuck inside this card.^000000",
			"^1133aaMy appearance has... well...^000000",
			"^1133aabegun to resemble its shadowy fluff, much to my dismay. I was once ever so bright and radiant. Truly.^000000",
			"^1133aaIf you would be so gracious, might I ask for a small favor? Please, if you would, scan my chubby, fluffy belly. It may be the only way for my spirit to slip free and continue its journey in another form.^000000",
			"^1133aaI would be endlessly thankful. Truly. Most obliged.^000000",
			"Type :^777777 Event Card^000000",
			"Usage :^777777 Click 'View' and use your QR Code Scanner^000000",
			"Weight :^777777 1^000000",
		},
