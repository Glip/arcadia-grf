		identifiedResourceName = "북",
		identifiedDescriptionName = {
			"An invisible book that holds forbidden knowledge.",
			"Weight :^777777 1^000000",
		},
		usages = {
			-- "EASTER_VALENTINES_E26",
		},
		slotCount = 0,
		ClassNum = 0
	},
	-- end OriginsRO Custom [Third block]

}

dofile("aodata/usage_db.lub")

--Function #0
main = function()
	for usageConstant,usage in pairs(usage_tbl) do
		name = usage.name
		if usage.itemId then
			name = name .. tbl[usage.itemId].identifiedDisplayName
		end
		result, msg = AddUsage(usage.id, usage.type, name, usage.url)
		if not result then
			return false, msg
		end

		for k, v in pairs(usage.description) do
			result, msg = AddUsageDescription(usage.id, v)
			if not result then
				return false, msg
			end
		end
	end
	for ItemID,DESC in pairs(tbl) do
		result, msg = AddItem(ItemID, DESC.unidentifiedDisplayName, DESC.unidentifiedResourceName, DESC.identifiedDisplayName, DESC.identifiedResourceName, DESC.slotCount, DESC.ClassNum)
		if not result then
			return false, msg
		end

		if DESC.usages then
			for k, v in pairs(DESC.usages) do
				usage = usage_tbl[v]
				if not usage then
					return false, ("usage not found: " .. v)
				end
				result, msg = AddItemUsage(ItemID, usage.id)
				if not result then
					return false, msg
				end
			end
		end

		for k,v in pairs(DESC.unidentifiedDescriptionName) do
			result, msg = AddItemUnidentifiedDesc(ItemID, v)
			if not result then
				return false, msg
			end
		end
		for k,v in pairs(DESC.identifiedDescriptionName) do
			result, msg = AddItemIdentifiedDesc(ItemID, v)
			if not result then
				return false, msg
			end
		end
	end
	return true, "good"
end
